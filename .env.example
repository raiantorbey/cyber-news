# Local PostgreSQL credentials. Change these before any non-local deployment.
POSTGRES_DB=signalwatch
POSTGRES_USER=signalwatch
POSTGRES_PASSWORD=signalwatch-local

# JSON array of browser origins allowed to call the API directly.
SIGNALWATCH_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Provider-facing identity. REQUIRED before sustained ingestion: NVD and GitHub
# both require a User-Agent that names the application and gives the operator a
# way to be contacted. The value below is a non-resolving placeholder and the
# worker warns while it is in use.
SIGNALWATCH_USER_AGENT=CyberNews/0.1 (+https://example.invalid/contact)
SIGNALWATCH_REQUEST_TIMEOUT_SECONDS=15
SIGNALWATCH_REQUEST_RETRIES=2

# Optional. GitHub works without a token; both keys raise provider rate limits.
SIGNALWATCH_GITHUB_TOKEN=
SIGNALWATCH_NVD_API_KEY=
SIGNALWATCH_GITHUB_QUERY=topic:cybersecurity pushed:>={since}

# Scheduled worker intervals and health freshness threshold, in seconds.
SIGNALWATCH_RSS_INTERVAL_SECONDS=900
SIGNALWATCH_NVD_INTERVAL_SECONDS=3600
SIGNALWATCH_CISA_INTERVAL_SECONDS=3600
SIGNALWATCH_GITHUB_INTERVAL_SECONDS=3600
SIGNALWATCH_FRESHNESS_THRESHOLD_SECONDS=7200
